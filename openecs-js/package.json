{
  "name": "openecs-js",
  "version": "0.2.0",
  "description": "A minimal importable OpenECS JavaScript runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "jsdelivr": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "files": [
    "dist",
    "examples",
    "src",
    "README.md",
    "AGENT.md",
    "WEBAGENT.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "validate": "npm run build && node ./scripts/validate-core.mjs",
    "bench": "npm run build && node ./scripts/bench-core.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
